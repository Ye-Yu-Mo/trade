# Binance 测试网 API 配置
BINANCE_API_KEY=your_testnet_api_key
BINANCE_SECRET=your_testnet_secret
BINANCE_TESTNET=true

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_key

# 交易配置
TRADE_SYMBOLS=BTCUSDT,ETHUSDT  # 多标的交易，逗号分隔
TRADE_INTERVAL=1m  # 可选: 1m, 15m, 30m, 1h
LEVERAGE=10  # 杠杆倍数: 1-125
MAX_POSITION=0.005  # 每个标的最大持仓量
PORTFOLIO_MODE=balanced  # 投资组合模式: balanced(均衡) | aggressive(激进) | conservative(保守)

# 可选：LLM 配置
# DEEPSEEK_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECS=60
# LLM_MAX_RETRIES=1      # 网络/超时重试次数
# LLM_JSON_MODE=true     # 强制模型输出 JSON
# LLM_CACHE_DIR=.cache/llm
# LLM_CACHE=off          # 关闭响应缓存（默认开启）

# 确定性风控（代码强制执行，不依赖 LLM）
RISK_ENABLED=true
RISK_STOP_LOSS_PCT=0.02      # 浮亏达到开仓名义价值的 2% 时平仓
RISK_TAKE_PROFIT_PCT=0.05    # 浮盈达到 5% 时平仓
RISK_MAX_DRAWDOWN_PCT=0.20   # 权益从峰值回撤 20% 时熔断
RISK_DAILY_LOSS_PCT=0.05     # 当日亏损 5% 时熔断
RISK_CLOSE_ON_HALT=true      # 熔断时强制平掉已有仓位
RISK_EXCHANGE_STOPS=true     # 在交易所挂 closePosition 条件单作为兜底
RISK_TRIGGER_TYPE=MARK_PRICE # 条件单触发价：MARK_PRICE | CONTRACT_PRICE
